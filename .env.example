# ── ERP headless CMS (Page Creation + Page Editing) ─────────────────────────
# Leave CMS_API_URL / CMS_SITE_DOMAIN unset to switch the integration off: the
# site then renders exactly as it does without the ERP.

# Public HTTPS address of the ERP backend (a LAN address like
# http://192.168.x.x:5000 is not reachable from the live site).
CMS_API_URL=https://apierp.clickmasters.pk
# This website's domain as registered in the ERP (no protocol, no www).
CMS_SITE_DOMAIN=clickmasterswebdevelopmentcompany.com

# Shared secret for POST /api/erp-revalidate (the ERP calls it right after a
# publish so changes show immediately). Must equal ERP_REVALIDATE_SECRET in
# the ERP backend's .env. Never commit the real value.
ERP_REVALIDATE_SECRET=

# Origin of the ERP web app, allowed to show this site in its "Live page"
# preview iframe (CSP frame-ancestors). Unset = framing blocked as before.
CMS_EDITOR_ORIGIN=https://erp.clickmasters.pk

# Optional
# NEXT_PUBLIC_CMS_LIVE_UPDATES=all     # live in-place updates: all (default) | editor | off
# CMS_APPLY_THEME_COLORS=true          # map ERP primary color onto the site theme
# CMS_ANTI_FLICKER=off                 # don't hide <main> (max 1.5s) while edits load
# CMS_ALLOW_CUSTOM_JS=true             # run pages' customCode.js (off by default)
# CMS_DEBUG=1                          # log ERP fetch failures in production too
